# Copy to server/.env for local development.

# SQLite file used by Prisma (portable for the lab demo).
DATABASE_URL="file:./prisma/dev.db"

# Required. Use a long random string in any shared environment.
JWT_SECRET="replace-with-a-long-random-secret"

# Server
PORT=3001
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# OpenAI — optional. If OPENAI_API_KEY is empty, the app runs in
# local demonstration mode with a built-in opponent and analysis fallback.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
